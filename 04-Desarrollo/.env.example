# =============================================================================
# EMUNÁ SPORT - Variables de entorno de ejemplo (.env.example)
# Copiar a .env para desarrollo local. NUNCA subir .env con valores reales a Git.
# =============================================================================

DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=cambiar-esta-clave-en-tu-archivo-env-local-minimo-50-caracteres
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Base de datos (en local usa SQLite por defecto si no se define DATABASE_URL)
# DATABASE_URL=postgres://usuario:clave@localhost:5432/emuna_sport

# Seguridad CORS y CSRF (lista blanca de orígenes separados por coma)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Almacenamiento Cloudflare R2 (compatible con S3 - en local usa disco)
USE_S3_STORAGE=False
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=
R2_BUCKET_PRIVATE=
R2_PUBLIC_URL=

# Protección Antispam Cloudflare Turnstile (llaves de prueba oficiales para local)
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Analítica y URL pública
SITE_URL=http://127.0.0.1:8000
GA4_MEASUREMENT_ID=
CLOUDFLARE_BEACON_TOKEN=
ADMIN_URL=gestion/
